# Claude Telegram Bot - Environment Configuration

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=123456789

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# Working directory where Claude runs (loads CLAUDE.md, skills, MCP config)
CLAUDE_WORKING_DIR=/Users/yourname/personal

# OpenAI API key for voice message transcription
# Without this, voice messages won't work
OPENAI_API_KEY=sk-...

# ==============================================================================
# OPTIONAL - Security
# ==============================================================================

# Comma-separated paths Claude can access
# Default: working dir, ~/Documents, ~/Downloads, ~/Desktop, ~/.claude
# Note: Setting this OVERRIDES defaults. Include ~/.claude for plan mode to work.
# ALLOWED_PATHS=/Users/yourname/personal,/Users/yourname/projects,/Users/yourname/.claude

# Rate limiting (token bucket)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# OPTIONAL - AI Agent Selection
# ==============================================================================

# Choose which AI coding CLI to use (default: claude-code)
# Options: claude-code, codex-cli, opencode
# AI_AGENT_TYPE=claude-code

# Model to use (adapter-specific defaults if not set)
# Claude Code: claude-sonnet-4-20250514
# Codex CLI: gpt-5.3-codex
# OpenCode: depends on provider
# AI_MODEL=claude-sonnet-4-20250514

# Maximum thinking tokens (default: 10000)
# Set to 0 to disable thinking
# MAX_THINKING_TOKENS=10000

# ==============================================================================
# OPTIONAL - Claude Code Authentication
# ==============================================================================

# API key for environments without Claude Code CLI auth
# Get from: https://console.anthropic.com/
# Note: API usage is billed per token - CLI auth is more cost-effective
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Path to Claude CLI (auto-detected from PATH by default)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# ==============================================================================
# OPTIONAL - Extended Thinking
# ==============================================================================

# Keywords that trigger extended thinking (comma-separated, case-insensitive)
# THINKING_KEYWORDS=think,pensa,ragiona

# Keywords that trigger deep thinking (50k tokens)
# THINKING_DEEP_KEYWORDS=ultrathink,think hard,pensa bene

# ==============================================================================
# OPTIONAL - Voice Transcription
# ==============================================================================

# Additional context for voice transcription (names, technical terms, etc.)
# TRANSCRIPTION_CONTEXT=Common names: John, Alice. Tech: Kubernetes, GraphQL.

# ==============================================================================
# OPTIONAL - Voice Mode (TTS)
# ==============================================================================

# Google Cloud TTS API key for voice responses
# Get from: https://console.cloud.google.com/apis/credentials
# Enable Text-to-Speech API first: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# GOOGLE_TTS_API_KEY=AIza...

# Voice and language for TTS (optional, defaults shown)
# GOOGLE_TTS_VOICE=en-US-Neural2-J
# GOOGLE_TTS_LANGUAGE=en-US

# ==============================================================================
# OPTIONAL - Logging
# ==============================================================================

# Audit log path
# AUDIT_LOG_PATH=/tmp/claude-telegram-audit.log

# Output audit logs as JSON (default: human-readable)
# AUDIT_LOG_JSON=false

# ==============================================================================
# OPTIONAL - File Forwarding
# ==============================================================================

# Maximum file size for raw mode forwarding (default: 50MB)
# RAW_FILE_MAX_SIZE=52428800

# Response size threshold for auto-saving (default: 3500 chars)
# Responses exceeding this are saved to file instead of sent via Telegram
# RESPONSE_SIZE_THRESHOLD=3500

# Enable auto-save of large responses (default: true)
# AUTO_SAVE_LARGE_RESPONSES=true

# File retention period in days (default: 7)
# Files older than this are automatically deleted
# Set to 0 to disable auto-cleanup
# FILE_RETENTION_DAYS=7

# Cleanup interval in milliseconds (default: 24 hours)
# CLEANUP_INTERVAL_MS=86400000

# ==============================================================================
# OPTIONAL - Smart Table Rendering
# ==============================================================================

# Enable three-tier table rendering (default: true)
# Tier 1: Simple tables (≤3x3) → row-by-row list
# Tier 2: Complex tables (4-20 rows, 4-10 cols) → PNG images
# Tier 3: Large tables (>20 rows or >10 cols) → PNG preview + CSV download
# ENABLE_SMART_TABLE_RENDERING=true

# Maximum columns/rows for simple list format (both conditions must be met)
# TABLE_SIMPLE_MAX_COLS=3
# TABLE_SIMPLE_MAX_ROWS=3

# Minimum columns/rows to trigger CSV download (either condition triggers it)
# TABLE_LARGE_MIN_COLS=10
# TABLE_LARGE_MIN_ROWS=20

# Maximum width for table images in pixels
# TABLE_IMAGE_MAX_WIDTH=800
